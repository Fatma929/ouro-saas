# ============================================================================
# OURO — Cloud-Agnostic Configuration Template (.env.example)
# NEVER commit real credentials or secrets to version control.
# ============================================================================

# --- Application & Runtime ---
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"
# SERVICE_NAME="ouro-api"
# TRUST_PROXY="1"

# VITE_APP_ENV: Set to 'production' in live deployments to hide staging test helpers.
VITE_APP_ENV="staging"

# VITE_GOOGLE_MAPS_API_KEY: Scoped browser Google Maps Platform API key (HTTP referrer restricted).
VITE_GOOGLE_MAPS_API_KEY=""

# GEMINI_API_KEY: Optional Gemini API key (managed via platform secrets if enabled).
GEMINI_API_KEY=""

# ALLOW_PILOT_SEED: Set to "true" ONLY in staging/pilot environments. Keep "false" in commercial production.
ALLOW_PILOT_SEED="false"

# --- Security, CORS, Auth & Signing Secrets ---
# ALLOWED_ORIGINS: Comma-separated explicit browser origins allowed for CORS (never use '*').
# ALLOWED_ORIGINS="https://app.ouro-circular.com,https://staging.ouro-circular.com"
# FIREBASE_PROJECT_ID: Optional Firebase project ID override for portable cloud deployments.
# FIREBASE_PROJECT_ID=""
# FIREBASE_SERVICE_ACCOUNT_JSON: Optional JSON or base64-encoded service account for non-GCP hosts (AWS/Docker).
# FIREBASE_SERVICE_ACCOUNT_JSON=""
# OURO_BOOTSTRAP_ADMIN_EMAIL: Required in production for first-time Firebase admin verification (no hardcoded fallback).
OURO_BOOTSTRAP_ADMIN_EMAIL=""
# OURO_SESSION_SECRET: 32+ char HMAC signing secret for server-verified role sessions (mandatory in production).
OURO_SESSION_SECRET=""
# OURO_FILE_SIGN_SECRET: 32+ char HMAC signing secret for short-lived private document download URLs (mandatory in production).
OURO_FILE_SIGN_SECRET=""

# --- 1. Database Connectivity (PostgreSQL — AWS RDS, GCP Cloud SQL, Neon, Supabase, or Local) ---
# Standard discrete PostgreSQL variables (used by managed Cloud SQL / local Postgres):
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
# Optional overrides for 12-factor URL, custom port, Unix socket, TLS, and pool tuning:
# DATABASE_URL="postgres://user:password@host:5432/ouro"
# SQL_PORT="5432"
# DB_SOCKET_PATH="/cloudsql/project:region:instance"
# DB_SSL="disable"                  # disable | require | no-verify
# DB_SSL_CA_CERT=""
# DB_POOL_MAX="10"
# DB_IDLE_TIMEOUT_MS="30000"
# DB_CONNECT_TIMEOUT_MS="15000"

# --- 2. Object Storage (local | s3 | gcs) ---
# Defaults to 'local' (./storage/private) with zero cloud services required in local dev.
# Uncomment and set to switch providers without code changes:
# STORAGE_PROVIDER="local"          # local | s3 | gcs
# STORAGE_SIGNED_URL_MODE="proxy"   # proxy (HMAC /api/storage/:id?sig=...) | direct (native S3/GCS signed URL)
# STORAGE_MAX_FILE_BYTES="8388608"
# LOCAL_STORAGE_DIR="./storage/private"
#
# S3-compatible provider settings (AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces):
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"
# S3_KEY_PREFIX="ouro"
#
# Google Cloud Storage settings (when STORAGE_PROVIDER="gcs"):
# GCS_BUCKET=""
# GCS_PROJECT_ID=""
# GCS_KEY_FILE=""
# GCS_KEY_PREFIX="ouro"

# --- 3. Cache & Distributed Rate Limiting (memory | redis) ---
# Defaults to 'memory' in local dev. Multi-instance production requires a valid REDIS_URL.
# CACHE_PROVIDER="memory"           # memory | redis
# DEPLOYMENT_TOPOLOGY="single-instance" # single-instance | multi-instance
# ALLOW_IN_MEMORY_CACHE_IN_PROD="false"
# REDIS_URL="rediss://default:password@redis-host:6379"
# REDIS_KEY_PREFIX="ouro:"
# REDIS_CONNECT_TIMEOUT_MS="5000"

# --- 4. Transactional Email Delivery (none | resend | smtp) ---
# Defaults to 'none' (in-app notifications active, no external email calls).
# EMAIL_PROVIDER="none"             # none | resend | smtp
# EMAIL_FROM="OURO Platform <no-reply@ouro.local>"
# RESEND_API_KEY="re_..."
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""

# --- 5. Background Jobs (memory | redis) ---
# JOBS_PROVIDER="memory"            # memory | redis
# JOBS_REDIS_PREFIX="ouro:jobs:"
# JOBS_MAX_ATTEMPTS="3"
# JOBS_BACKOFF_MS="500"

# --- 6. Structured Logging ---
# LOG_LEVEL="info"                  # debug | info | warn | error
# LOG_FORMAT="json"                 # json | pretty

