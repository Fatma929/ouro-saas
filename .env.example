# GEMINI_API_KEY: Optional Gemini API key managed by AI Studio Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted application URL injected at runtime.
APP_URL="MY_APP_URL"

# NODE_ENV: Set to 'production' in live cloud deployments.
NODE_ENV="development"

# VITE_GOOGLE_MAPS_API_KEY: Scoped browser Google Maps Platform API key (HTTP referrer restricted).
VITE_GOOGLE_MAPS_API_KEY=""

# VITE_APP_ENV: Set to 'production' in live deployments to hide staging test helpers.
VITE_APP_ENV="staging"

# Cloud SQL (PostgreSQL) runtime variables provided by platform environment:
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# PORT: Server HTTP port (defaults to 3000; injected automatically by Cloud Run).
PORT="3000"

# ALLOW_PILOT_SEED: Set to "true" ONLY in staging/pilot environments if you want sample organizations and demo accounts seeded when NODE_ENV=production. Keep unset or "false" in live commercial production.
ALLOW_PILOT_SEED="false"

# OURO_BOOTSTRAP_ADMIN_EMAIL: Optional bootstrap platform admin email for first-time Firebase admin verification.
OURO_BOOTSTRAP_ADMIN_EMAIL=""

# OURO_SESSION_SECRET: HMAC signing secret for server-verified role sessions (set a strong 32+ char secret in production).
OURO_SESSION_SECRET=""

# OURO_FILE_SIGN_SECRET: HMAC signing secret for short-lived private document download URLs.
OURO_FILE_SIGN_SECRET=""

# REDIS_URL: Optional Redis connection string for distributed rate limiting across multi-instance Cloud Run replicas.
REDIS_URL=""

# Optional transactional email provider (leave empty to operate in honest in-app notification mode):
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
